# Modelcar of RedHatAI/Qwen3.8-27B-NVFP4 for KServe (storageUri: oci://...).
#
# Every file comes from Hugging Face at one fixed commit and is checked with its sha256.
# One ADD per large file gives one layer per file: CRI-O pulls the layers in parallel,
# while a single 25 GB layer is pulled over one connection only.
#
# Build: scripts/build-on-openshift.sh qwen38-27b-nvfp4 <tag>  (see README.md)

# DL3020: every ADD downloads a URL (${HF_URL}/...); hadolint does not expand the ARG.
# hadolint global ignore=DL3020

# ubi9/ubi-micro 9.8 (linux/amd64), resolved on registry.access.redhat.com on 2026-09-28.
# KServe starts the modelcar as a sidecar with a shell command, so the image needs a shell.
FROM registry.access.redhat.com/ubi9/ubi-micro@sha256:932aec77f5b86a5dba854a18b14a38725b296967e7dc9c7a1f4d7f0bf82e1ce5

# Hugging Face commit of RedHatAI/Qwen3.8-27B-NVFP4, resolved on 2026-09-28 (last change 2026-09-25).
ARG HF_URL=https://huggingface.co/RedHatAI/Qwen3.8-27B-NVFP4/resolve/d23c6ff198a005532746610e9d719c9f6d27a2b1

LABEL name="modelcar-qwen38-27b-nvfp4" \
      summary="Qwen3.8-27B-NVFP4 (RedHatAI) model files for KServe modelcar" \
      org.opencontainers.image.source="https://github.com/sovereign-selfheal/modelcar" \
      org.opencontainers.image.licenses="Apache-2.0" \
      model.source="https://huggingface.co/RedHatAI/Qwen3.8-27B-NVFP4" \
      model.revision="d23c6ff198a005532746610e9d719c9f6d27a2b1"

